GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Backend: secret used to sign short-lived analysis identities for /api/chat.
# Optional (falls back to GEMINI_API_KEY, then an ephemeral per-process key),
# but set it in production, especially with multiple backend workers.
# Example: SCANORA_SESSION_SECRET=a-long-random-string
SCANORA_SESSION_SECRET=

# Frontend (Vite): base URL of the FastAPI backend in production.
# Leave unset for local development so requests use the Vite /api proxy.
# Example: VITE_API_BASE_URL=https://scanora-backend.example.com
VITE_API_BASE_URL=
